  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "A Psalm of David."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "Jehovah is my shepherd; I shall not want.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "He maketh me to lie down in green pastures; he leadeth me beside still waters.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "He restoreth my soul; he leadeth me in paths of righteousness for his name's sake.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou art with me; thy rod and thy staff, they comfort me.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "Thou preparest a table before me in the presence of mine enemies; thou hast anointed my head with oil; my cup runneth over.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Surely, goodness and loving-kindness shall follow me all the days of my life; and I will dwell in the house of Jehovah for the length of the days.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
