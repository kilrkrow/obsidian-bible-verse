  "chapter": {
    "number": 23,
    "content": [
      {
        "type": "hebrew_subtitle",
        "content": [
          "A psalm of David."
        ]
      },
      {
        "type": "verse",
        "number": 1,
        "content": [
          {
            "text": "The Lord is my shepherd,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "I lack nothing.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          {
            "text": "He takes me to lush pastures,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "he leads me to refreshing water.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          {
            "text": "He restores my strength.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "He leads me down the right paths",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "for the sake of his reputation.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Even when I must walk through the darkest valley,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "I fear no danger,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "for you are with me;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "your rod and your staff reassure me.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          {
            "text": "You prepare a feast before me",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "in plain sight of my enemies.",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "You refresh my head with oil;",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "my cup is completely full.",
            "poem": 1
          },
          {
            "lineBreak": true
          }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Surely your goodness and faithfulness will pursue me all my days,",
            "poem": 1
          },
          {
            "lineBreak": true
          },
          {
            "text": "and I will live in the Lord’s house for the rest of my life.",
            "poem": 1
          }
        ]
      }
    ],
    "footnotes": []
  },
